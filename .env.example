# Copy to .env (never commit .env). Defaults work for local Ollama + docker compose.
DB_URL=postgresql://copilot:copilot@localhost:5432/copilot
DB_PORT=5432

# Any OpenAI-compatible endpoint. Local default: Ollama (run natively, see ollama/Modelfile).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=copilot-qwen
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
EMBED_TASK_PREFIXES=true
# OpenAI instead:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
#                  EMBED_MODEL=text-embedding-3-small  EMBED_TASK_PREFIXES=false   (then re-run ingest)

# Demo API keys -> RM. Replace for any shared deployment.
API_KEYS=rm1-demo-key:RM-1,rm2-demo-key:RM-2,rm3-demo-key:RM-3,rm4-demo-key:RM-4,rm5-demo-key:RM-5

# Retrieval gate (see scripts/calibrate_threshold.py)
RAG_MIN_SIM=0.60
RAG_MIN_SIM_WITH_KEYWORD=0.53
RAG_MIN_FTS=0.025
